{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "guest-js",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["guest-js/**/*.ts"],
  "exclude": ["guest-js/**/*.test.ts"]
}
