# The site is a project of its own, even inside a repository that is a pnpm
# workspace already: this file is where pnpm stops looking upward.

# Before a script runs, pnpm holds node_modules to the lockfile and installs
# what has fallen behind it: a gate run against older packages than the lock
# names passes for something other than what ships.
verifyDepsBeforeRun: install

# pnpm 11 is broken on Windows; the line stays on 10.
onlyBuiltDependencies:
  - esbuild
  - sharp

# Advisories accepted on purpose, each with the reason next to it. The site's
# audit (.github/workflows/docs-audit.yml) fails on any other.
auditConfig:
  ignoreGhsas:
    # postcss-selector-parser 6.x, reached through expressive-code ->
    # postcss-nested: quadratic parsing of a long flat selector. Only a parser
    # of untrusted selectors in a request path is exposed; the site parses its
    # own CSS at build time. The fix is in 7.x, which postcss-nested 6 does not
    # take - drop this line when expressive-code moves on.
    - GHSA-rj75-hqrm-r3gf
