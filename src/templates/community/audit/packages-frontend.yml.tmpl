{{#spa}}
  # The web UI's production dependencies: they are compiled into the binary.
  # The dev toolchain's advisories reach the machine that builds, not the
  # people who use what it built, and they are taken in the weekly update.
  packages:
    name: Packages
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v7
      - uses: pnpm/action-setup@v6
        with:
          package_json_file: frontend/package.json
      - uses: actions/setup-node@v7
        with:
          node-version: 22
          cache: pnpm
          cache-dependency-path: frontend/pnpm-lock.yaml
      - run: pnpm install --frozen-lockfile
      - name: Advisories
        run: pnpm audit --prod
      - name: Licenses
        run: node tools/check-licenses.mjs
{{/spa}}
