name: Shopfronts

# The README, the manifests, the changelog and the documentation site say one
# version, one description and the commands the program has: `lyrn check`
# holds them to each other. On every push, documentation alone included - the
# shopfronts are mostly documentation.
on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    name: lyrn check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
