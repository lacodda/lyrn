# The package is what ships; the workspace around it is private and carries
# no version.
manifests = ["packages/{{ name }}/package.json"]
# ADRs record what happened: the versions they name are history.
as_written = ["docs/adr/"]

[gate]
# The lint alone: it takes seconds and builds nothing. The rest of the gate is
# CI, which the run waits for before the tag.
commands = [
    "pnpm exec eslint .",
]

[ci]
provider = "github"
workflow = "ci.yml"
publish = "publish.yml"

[[package]]
registry = "npm"
name = "{{ name }}"
manifest = "packages/{{ name }}/package.json"
