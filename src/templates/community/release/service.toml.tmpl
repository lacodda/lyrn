manifests = [
    "Cargo.toml",
{{#spa}}
    "frontend/package.json",
{{/spa}}
]
# ADRs record what happened: the versions they name are history.
as_written = ["docs/adr/"]

[gate]
# Formatting only: it takes seconds and compiles nothing. The rest of the gate
# is CI, which the run waits for before the tag.
commands = [
    "cargo fmt --check",
]

[ci]
provider = "github"
workflow = "ci.yml"

# The service goes out to its stand: turnout deploys it from here and checks
# the stand's health. Which stand is turnout's own configuration, not this
# file's.
[post.deploy]
