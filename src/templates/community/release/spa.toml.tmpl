manifests = ["package.json"]
# ADRs record what happened: the versions they name are history.
as_written = ["docs/adr/"]

[gate]
# The lint alone: it takes seconds and builds nothing. The rest of the gate is
# CI, which the run waits for before the tag.
commands = [
    "pnpm exec eslint .",
]

[ci]
provider = "github"
workflow = "ci.yml"

# The app goes out to its stand: turnout deploys it from here and checks the
# stand's health. Which stand is turnout's own configuration, not this file's.
[post.deploy]
