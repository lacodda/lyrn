# Both halves carry one version: they ship together.
manifests = ["Cargo.toml", "package.json"]
# ADRs record what happened: the versions they name are history.
as_written = ["docs/adr/"]

[gate]
# Formatting only: it takes seconds and compiles nothing. The rest of the gate
# is CI, which the run waits for before the tag.
commands = [
    "cargo fmt --check",
]

[ci]
provider = "github"
workflow = "ci.yml"
publish = "publish.yml"

[[package]]
registry = "crates"
name = "tauri-plugin-{{ name }}"
manifest = "Cargo.toml"

[[package]]
registry = "npm"
name = "tauri-plugin-{{ name }}-api"
manifest = "package.json"
