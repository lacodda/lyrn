manifests = ["Cargo.toml"]
# ADRs record what happened: the versions they name are history.
as_written = ["docs/adr/"]

[gate]
# Formatting only: it takes seconds and compiles nothing. The rest of the gate
# is CI, which the run waits for before the tag.
commands = [
    "cargo fmt --check",
]

[ci]
provider = "github"
workflow = "ci.yml"

# The archives the host installs the plugin from: the release page has to
# carry one for every target.
[page]
assets = [
    "{{ bin_name }}-{tag}-x86_64-pc-windows-msvc.zip",
    "{{ bin_name }}-{tag}-x86_64-unknown-linux-gnu.tar.gz",
    "{{ bin_name }}-{tag}-aarch64-apple-darwin.tar.gz",
]
