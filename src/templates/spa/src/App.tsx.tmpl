import { useState } from 'react'

export function App() {
  const [count, setCount] = useState(0)

  return (
    <main className="flex min-h-full flex-col items-center justify-center gap-6 p-8">
      <h1 className="text-xl font-semibold text-text">{{ title }}</h1>
      <p className="max-w-prose text-center text-dim">{{ description }}</p>
      <button
        type="button"
        onClick={() => setCount((value) => value + 1)}
        className="rounded-md bg-accent px-4 py-2 font-semibold text-on-accent hover:bg-accent-2"
      >
        Clicked {count} times
      </button>
      <p className="text-sm text-dim">
        Add a primitive with <code className="font-mono">npx shadcn add {{ registry }}/button.json</code>
      </p>
    </main>
  )
}
