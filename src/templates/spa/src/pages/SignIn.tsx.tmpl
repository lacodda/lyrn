import { LoginScreen, type LoginCredentials, type LoginScreenWords } from '@/components/blocks/login-screen'
import { ApiError } from '@/lib/api'
import { useSession } from '@/lib/session'

/** Every word the screen shows: the block has none of its own. */
const WORDS: LoginScreenWords = {
  identifier: 'Email',
  password: 'Password',
  show: 'Show password',
  hide: 'Hide password',
  submit: 'Sign in',
  submitting: 'Signing in...',
  failed: 'The server cannot be reached. Try again in a moment.',
}

/**
 * The page a visitor signs in on: dowel's LoginScreen block, told what this
 * product's server answers. The block is the screen - the fields a password
 * manager can tell apart, one attempt at a time, a field a phone does not
 * zoom into - and it is this project's copy to change from here on.
 *
 * The server refuses an unknown address and a wrong password with the same
 * answer on purpose, so the screen does not guess which it was. Anything else
 * is the server out of reach: thrown on, so the block says `failed`, which is
 * more use than "wrong password" to someone whose password is right.
 */
export function SignIn() {
  const { signIn } = useSession()

  async function submit({ identifier, password }: LoginCredentials) {
    try {
      await signIn(identifier, password)
    } catch (error: unknown) {
      if (error instanceof ApiError && error.isUnauthorized) return 'That email and password do not match.'
      throw error
    }
  }

  return <LoginScreen title="Sign in to {{ title }}" onSubmit={submit} words={WORDS} />
}
