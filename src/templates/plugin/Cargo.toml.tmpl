[package]
name = "{{ bin_name }}"
version = "0.1.0"
edition = "2024"
rust-version = "{{ msrv }}"
description = "{{ description }}"
authors = ["{{ author }}"]
license = "MIT"
readme = "README.md"
keywords = ["{{ host }}", "plugin"]
categories = ["command-line-utilities"]

exclude = [
    "docs/",
    ".github/",
    "cliff.toml",
    "rustfmt.toml",
]

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[dev-dependencies]
assert_cmd = "2"
predicates = "3"

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
all = { level = "deny", priority = -1 }

# A plugin binary is downloaded far more often than it is built, and it is
# downloaded once per host installation.
[profile.release]
lto = true
codegen-units = 1
strip = true
