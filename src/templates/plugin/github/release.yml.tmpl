name: Release

on:
  push:
    tags: ['v*']
  # A tag whose run GitHub lost - a job never created, a rerun refused - is
  # built again with `gh workflow run release.yml --ref vX.Y.Z`: the tag stays
  # where it is, and publish waits for this run on the tag's commit.
  workflow_dispatch:

permissions:
  contents: write

env:
  CARGO_TERM_COLOR: always

jobs:
  build:
    name: ${{ matrix.target }}
    # Dispatched on a branch, the run would release the branch's name.
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: windows-latest
            target: x86_64-pc-windows-msvc
          - os: ubuntu-latest
            target: x86_64-unknown-linux-gnu
          - os: macos-latest
            target: aarch64-apple-darwin
    steps:
      - uses: actions/checkout@v7
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}
      - uses: Swatinem/rust-cache@v2
      # Named explicitly so the same step works whether this repository holds
      # one crate or a workspace: without it, a workspace would build every
      # member for the release target and package the wrong binary.
      - name: Build
        run: cargo build --release --package {{ bin_name }} --target ${{ matrix.target }}
      - name: Package (Windows)
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          $name = "{{ bin_name }}-${{ github.ref_name }}-${{ matrix.target }}"
          New-Item -ItemType Directory $name | Out-Null
          Copy-Item "target/${{ matrix.target }}/release/{{ bin_name }}.exe", "LICENSE", "README.md" $name
          Compress-Archive -Path $name -DestinationPath "$name.zip"
      - name: Package (Unix)
        if: runner.os != 'Windows'
        shell: bash
        run: |
          name="{{ bin_name }}-${{ github.ref_name }}-${{ matrix.target }}"
          mkdir "$name"
          cp "target/${{ matrix.target }}/release/{{ bin_name }}" LICENSE README.md "$name"
          tar czf "$name.tar.gz" "$name"
      - uses: actions/upload-artifact@v7
        with:
          name: package-${{ matrix.target }}
          path: |
            {{ bin_name }}-*.zip
            {{ bin_name }}-*.tar.gz
          if-no-files-found: error

  release:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - name: Generate release notes
        uses: orhun/git-cliff-action@v4
        id: cliff
        with:
          config: cliff.toml
          args: --latest --strip header
      # The changelog's section for the tag, then .github/release-notes.md:
      # the checklist ticked once the release has been through it.
      - name: Write the release notes
        env:
          CHANGES: ${{ steps.cliff.outputs.content }}
        run: |
          printf '%s\n\n' "$CHANGES" > release-notes.md
          cat .github/release-notes.md >> release-notes.md
      - uses: actions/download-artifact@v8
        with:
          path: packages
          merge-multiple: true
      - name: Create GitHub Release
        uses: softprops/action-gh-release@v3
        with:
          body_path: release-notes.md
          files: packages/*
