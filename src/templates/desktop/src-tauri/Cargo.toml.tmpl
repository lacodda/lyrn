[package]
name = "{{ name }}"
version = "0.1.0"
edition = "2024"
rust-version = "{{ msrv }}"
description = "{{ description }}"
authors = ["{{ author }}"]
license = "MIT"

[lib]
# The desktop shell is a library with a thin binary in front of it, which is
# what lets integration tests reach the application without launching a window.
name = "{{ lib_name }}"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = [] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
thiserror = "2"

[profile.release]
lto = true
codegen-units = 1
strip = true
