/// A health check that touches the database.
///
/// A process that answers while its database is unreachable is worse than one
/// that does not answer at all: an orchestrator keeps sending it traffic.
pub async fn health(State(pool): State<PgPool>) -> (StatusCode, Json<Health>) {
    let version = env!("CARGO_PKG_VERSION");
{{#demo}}
    // The label lives in the database, so the answer is the data's, not the
    // flag's: a demo database stays one after the flag is gone.
    match sqlx::query_scalar::<_, bool>("SELECT EXISTS (SELECT 1 FROM demo)").fetch_one(&pool).await {
        Ok(demo) => (StatusCode::OK, Json(Health { status: "ok", version, demo })),
        Err(_) => {
            (StatusCode::SERVICE_UNAVAILABLE, Json(Health { status: "database unreachable", version, demo: false }))
        }
    }
{{/demo}}
