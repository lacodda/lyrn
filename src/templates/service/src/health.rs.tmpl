use axum::{Json, extract::State, http::StatusCode};
use serde::Serialize;
use sqlx::PgPool;

#[derive(Serialize)]
pub struct Health {
    pub status: &'static str,
    pub version: &'static str,
{{#demo}}
    /// Whether the data is made up, so a screen can say so.
    pub demo: bool,
