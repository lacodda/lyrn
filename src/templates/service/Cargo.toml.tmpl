[package]
name = "{{ name }}"
version = "0.1.0"
edition = "2024"
rust-version = "{{ msrv }}"
description = "{{ description }}"
authors = ["{{ author }}"]
license = "MIT"
readme = "README.md"

[dependencies]
anyhow = "1"
axum = "0.8"
clap = { version = "4", features = ["derive", "env"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sqlx = { version = "0.9", features = ["runtime-tokio", "tls-rustls", "postgres", "migrate", "chrono", "uuid"] }
tokio = { version = "1", features = ["full"] }
thiserror = "2"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter", "fmt"] }
{{#spa}}
# The built web UI is compiled into the binary, so a self-hosted install is one
# file and the UI can never be from a different build than the API it calls.
rust-embed = { version = "8", features = ["mime-guess"] }
{{/spa}}

[dev-dependencies]
# Integration tests talk to a real Postgres: the logic lives in SQL, and a
# mocked pool proves nothing about what the database will actually do.
sqlx = { version = "0.9", features = ["runtime-tokio", "postgres", "migrate"] }

[profile.release]
lto = true
codegen-units = 1
strip = true
