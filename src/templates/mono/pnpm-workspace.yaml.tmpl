packages:
  - packages/*
{{#stand}}
  # The stand imports the package by its published name, which resolves only
  # because it is a workspace member: outside the workspace it would have to
  # install a copy, and then the page would show a build that is not this one.
  - stand
{{/stand}}

# Before a script runs, pnpm holds node_modules to the lockfile and installs
# what has fallen behind it: a gate run against older packages than the lock
# names passes for something other than what ships.
verifyDepsBeforeRun: install
