{
  "name": "{{ name }}-workspace",
  "description": {{ description_json }},
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
{{#stand}}
    "lint": "pnpm build && eslint . && pnpm -r --filter ./packages/* typecheck && tsc --project stand/tsconfig.json && pnpm test",
    "typecheck": "pnpm -r --filter ./packages/* typecheck && tsc --project stand/tsconfig.json",
    "stand": "pnpm --filter {{ name }}-stand dev",
    "stand:build": "pnpm --filter {{ name }}-stand build",
{{/stand}}
{{^stand}}
    "lint": "eslint . && pnpm -r --filter ./packages/* typecheck && pnpm test",
    "typecheck": "pnpm -r --filter ./packages/* typecheck",
{{/stand}}
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
{{#stand}}
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6",
{{/stand}}
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  }
}
