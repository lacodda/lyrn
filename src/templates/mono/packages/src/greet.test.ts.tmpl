import { describe, expect, it } from 'vitest'

import { greet } from './greet.js'

describe('greet', () => {
  it('greets by name', () => {
    expect(greet('world')).toBe('Hello, world!')
  })

  it('puts a title before the name', () => {
    expect(greet('Ada', { title: 'Dr' })).toBe('Hello, Dr Ada!')
  })

  it('does not treat surrounding whitespace as part of the name', () => {
    expect(greet('  friend  ')).toBe('Hello, friend!')
  })

  it('throws rather than greeting nobody', () => {
    expect(() => greet('')).toThrow(RangeError)
    expect(() => greet('   ')).toThrow('a name is required')
  })
})
