// Embeds the Windows executable icon, so the binary is recognisable in
// Explorer and the task manager rather than showing the default one.
//
// The icon lives inside this crate: `cargo install` builds the published
// crate, which carries only what is under its own directory, so an icon
// reached through `../../assets` would build here and be missing from
// crates.io. Unconditional for the same reason: a package without its icon
// fails to build, rather than shipping a binary nobody notices is unmarked.
fn main() {
    #[cfg(windows)]
    {
        const ICON: &str = "assets/icon.ico";
        println!("cargo:rerun-if-changed={ICON}");
        winresource::WindowsResource::new().set_icon(ICON).compile().expect("failed to embed the Windows resources");
    }
}
