  crates-io:
    needs: release
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/checkout@v7
        with:
          ref: ${{ github.event_name == 'workflow_dispatch' && inputs.tag || github.ref }}
      - uses: dtolnay/rust-toolchain@stable
      # The first publish of each crate is by hand: a trusted publisher cannot
      # be attached to a crate that does not exist yet. Publish both by hand
      # once, add a publisher to each on crates.io, and this job takes over -
      # two crates means two publishers, and forgetting the second one fails
      # with a message that reads like a token problem and is not.
      - name: Get a crates.io token (OIDC trusted publishing)
        uses: rust-lang/crates-io-auth-action@v1
        id: auth
      # In order - the binary depends on the library, and crates.io refuses a
      # package whose dependency it cannot resolve; cargo waits for each to
      # reach the index before it returns. The single version is the
      # workspace's. A version crates.io holds already is skipped, so a re-run
      # picks up where a publish stopped.
      - name: Publish what crates.io does not hold yet
        env:
          CARGO_REGISTRY_TOKEN: ${{ steps.auth.outputs.token }}
        run: |
          set -euo pipefail
          version=$(cargo metadata --no-deps --format-version 1 | jq -r '[.packages[].version] | unique | .[0]')
          for crate in {{ name }}-core {{ name }}; do
            status=$(curl -s -o /dev/null -w '%{http_code}' -A '{{ name }}-publish' "https://crates.io/api/v1/crates/$crate/$version")
            case "$status" in
              200) echo "$crate $version is on crates.io already" ;;
              404) cargo publish --package "$crate" ;;
              *) echo "crates.io answered $status for $crate $version" >&2; exit 1 ;;
            esac
          done

  # The wrapper that downloads the binary from the release page - which is why
  # it waits for the release above.
  npm:
    needs: release
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/checkout@v7
        with:
          ref: ${{ github.event_name == 'workflow_dispatch' && inputs.tag || github.ref }}
      # npm >= 11.5.1 exchanges the OIDC token itself (trusted publishing);
      # provenance is attached automatically.
      - uses: actions/setup-node@v7
        with:
          node-version: 24
          check-latest: true
          registry-url: https://registry.npmjs.org
      # The first publish is by hand, as for the crates; a version npm holds
      # already is skipped.
      - name: Publish
        working-directory: npm
        run: |
          version=$(node -p "require('./package.json').version")
          if npm view "{{ name }}@$version" version > /dev/null 2>&1; then
            echo "{{ name }}@$version is on npm already"
          else
            npm publish
          fi
